---
import {EMAIL_ADDRESS, LINKEDIN_URL, TWITTER_URL, GITHUB_URL, DARKWRITE_WEBSITE, INSTAGRAM_URL, repo} from "@/lib/resources";
import { MobileNav } from "./MobileNav";
---
<nav class="absolute hidden z-10 md:flex top-0 left-0 right-0 justify-between p-12 ">
  <div class="flex gap-3 lg:gap-4 type-sm [&>a]:hover:underline">
    <a href="/#home">Home</a>
    <a href="/#about">About</a>
    <a href="/#work">Work</a>
    <a href="/#contact">Contact</a>
  </div>
  <div class="flex gap-3 lg:gap-4 type-sm [&>a]:hover:underline text-end">
    <a href={DARKWRITE_WEBSITE}>darkwrite.app</a>
    <a href={GITHUB_URL}>GitHub</a>
    <a href={LINKEDIN_URL}>LinkedIn</a>
    <a href={TWITTER_URL}>Twitter</a>
    <a href={INSTAGRAM_URL}>Instagram</a>
  </div>
</nav>
<div class="md:hidden">
  <MobileNav client:load />
</div>

---
import {EMAIL_ADDRESS, LINKEDIN_URL, TWITTER_URL, GITHUB_URL, DARKWRITE_WEBSITE, INSTAGRAM_URL, repo} from "@/lib/resources";
---
<footer class="lg:grid-cols-4 grid gap-6 px-12 bg-background-2 w-screen py-12">
  <a href="/" class="type-giant col-span-2">yeniceri.dev</a>
  <div class="flex flex-col gap-3 type-sm [&>a]:hover:underline">
    <a href="/#home">Home</a>
    <a href="/#about">About</a>
    <a href="/#work">Work</a>
    <a href="/#contact">Contact</a>
    <a href="/licenses.md">Third party licenses</a>
  </div>
  <div class="flex flex-col gap-3 type-sm [&>a]:hover:underline">
    <a href={DARKWRITE_WEBSITE}>darkwrite.app</a>
    <a href={GITHUB_URL}>GitHub</a>
    <a href={LINKEDIN_URL}>LinkedIn</a>
    <a href={TWITTER_URL}>Twitter</a>
    <a href={INSTAGRAM_URL}>Instagram</a>
    <a href={repo("yeniceri.dev")}>Source code for this website</a>
  </div>
</footer>

